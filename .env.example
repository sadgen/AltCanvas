# AltCanvas Server Configuration
PORT=8088
HOST=0.0.0.0
PUBLIC_ORIGIN=https://canvas.example.com
# TRUST_PROXY=true
# ALLOWED_HOSTS=canvas.example.com
# REQUIRE_ORIGIN=true

# Default Altero Backend URL (for OAuth & API proxying)
ALTERO_API=https://altero.example.com

# OAuth Client ID
OAUTH_CLIENT_ID=altcanvas

# Optional confidential-client secret. Prefer a secret manager in production.
# OAUTH_CLIENT_SECRET=

# For local HTTP-only OAuth development. Never enable in production.
# ALLOW_INSECURE_OAUTH=true

# For private-network Altero development only. Public deployments should keep this false.
# ALLOW_PRIVATE_HOSTS=true
# Allow users to select a node other than ALTERO_API. Keep disabled unless required.
# ALLOW_DYNAMIC_ALTERO=true
# Set false to disable the manual API-key compatibility UI in development.
# ALLOW_DIRECT_AUTH=false

# Add a private CA without disabling TLS verification globally:
# NODE_EXTRA_CA_CERTS=/run/secrets/altero-ca.pem

# Proxy safety limits
MAX_API_BODY_BYTES=1048576
MAX_CANVAS_BODY_BYTES=524288
# Whole-PDF AI analysis has a separate authenticated upload/text ceiling.
MAX_AI_DOCUMENT_BODY_BYTES=786432
MAX_AI_DOCUMENT_TEXT_CHARS=600000
AI_DOCUMENT_CHUNK_CHARS=30000
UPSTREAM_TIMEOUT_MS=15000
UPSTREAM_STREAM_IDLE_TIMEOUT_MS=30000

# Optional single-user AI provider. The browser never receives or stores this key.
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat
# AI_API_KEY=
# Optional external secret for encrypting per-user AI settings. Keep it separate from data backups.
# AI_SETTINGS_SECRET=
# AI_TIMEOUT_MS=60000
# AI_MAX_RESPONSE_BYTES=524288
# For a trusted local Ollama deployment only:
# ALLOW_PRIVATE_AI_HOSTS=true
# ALLOW_INSECURE_AI=true
# DEBUG_LOG_MAX_BYTES=2097152

# Host directory mounted at /app/data by Docker Compose
ALTCANVAS_DATA_DIR=./data
# Server-side path; normally keep /app/data in containers.
DATA_DIR=./data
# Independent Canvas database; defaults to $DATA_DIR/altcanvas-canvas.sqlite.
# CANVAS_DB_PATH=./data/altcanvas-canvas.sqlite
# Required for encrypted session persistence. Use at least 32 random bytes.
# SESSION_SECRET=
